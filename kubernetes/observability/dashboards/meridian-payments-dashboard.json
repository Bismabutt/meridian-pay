          "expr": "histogram_quantile(0.95, sum(rate(payment_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95",
          "refId": "B",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.99, sum(rate(payment_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99",
          "refId": "C",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "vector(0.3)",
          "legendFormat": "Objective (300ms)",
          "refId": "D",
          "editorMode": "code",
          "range": true
        }
      ]
