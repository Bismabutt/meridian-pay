          "expr": "histogram_quantile(0.50, sum(rate(payment_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50",
          "refId": "A",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
